# Copy to .env.local for development. Never commit real values.

# Public site origin used for canonical URLs, sitemap, JSON-LD and OG images.
NEXT_PUBLIC_SITE_URL=https://www.dhrubo.shop

# GA4 measurement ID (public). Defaults to the property attached to dhrubo.shop since Jan 2026.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1M1HKNCHYB

# Assistant (server-only). Any OpenAI-compatible chat-completions endpoint works.
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-20b
CHAT_PROVIDER_URL=https://api.groq.com/openai/v1/chat/completions
CHAT_RATE_LIMIT=12

# Contact form delivery via Resend (server-only). Without these the form falls back to mailto.
RESEND_API_KEY=
CONTACT_FROM=Dhrubo <hello@dhrubo.shop>
CONTACT_TO=dhrubojyoti.gangopadhyay@gmail.com

# Salt for hashing client IPs in rate-limit keys and logs.
RATE_LIMIT_SALT=change-me
